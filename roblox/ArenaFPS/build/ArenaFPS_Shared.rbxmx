		Range = 700,
		Falloff = { Start = 70, End = 220, Min = 0.65 },
		Spread = { Hip = 2.4, Ads = 0.35, Move = 1.6, Air = 4 },
		Recoil = { Pitch = 1.05, Yaw = 0.45, Kick = 0.14 },
		AdsFOV = 55,
		AdsSpeed = 12,
		SpeedMultiplier = 0.95,
		Sound = "RifleShot",
	},
	SMG = {
		DisplayName = "SMG",
		Slot = "Primary",
		Kind = "Gun",
		FireMode = "Auto",
		RPM = 900,
		Damage = 16,
		HeadMultiplier = 1.4,
		Pellets = 1,
		MagSize = 35,
		Reserve = 210,
		ReloadTime = 1.7,
		EquipTime = 0.35,
		Range = 450,
		Falloff = { Start = 35, End = 120, Min = 0.55 },
		Spread = { Hip = 2.8, Ads = 1.0, Move = 0.8, Air = 3 },
		Recoil = { Pitch = 0.6, Yaw = 0.55, Kick = 0.09 },
		AdsFOV = 62,
		AdsSpeed = 15,
		SpeedMultiplier = 1.0,
		Sound = "PistolShot",
	},
	Shotgun = {
		DisplayName = "Shotgun",
		Slot = "Primary",
		Kind = "Gun",
		FireMode = "Pump",
		RPM = 72,
		Damage = 11,
		HeadMultiplier = 1.25,
		Pellets = 9,
		MagSize = 6,
		Reserve = 36,
		ReloadTime = 2.6,
		EquipTime = 0.5,
		Range = 160,
		Falloff = { Start = 15, End = 60, Min = 0.3 },
		Spread = { Hip = 6.5, Ads = 4.8, Move = 0.5, Air = 1.5 },
		Recoil = { Pitch = 5.5, Yaw = 1.2, Kick = 0.45 },
		AdsFOV = 62,
		AdsSpeed = 10,
		SpeedMultiplier = 0.95,
		Sound = "ShotgunShot",
	},
	Sniper = {
		DisplayName = "Sniper",
		Slot = "Primary",
		Kind = "Gun",
		FireMode = "Bolt",
		RPM = 45,
		Damage = 90,
		HeadMultiplier = 2.0,
		Pellets = 1,
		MagSize = 5,
		Reserve = 30,
		ReloadTime = 3.0,
		EquipTime = 0.6,
		Range = 1500,
		Falloff = { Start = 1500, End = 1500, Min = 1 },
