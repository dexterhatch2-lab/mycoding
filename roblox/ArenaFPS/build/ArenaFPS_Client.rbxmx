<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4">
	<Item class="LocalScript" referent="RBX0000002D">
		<Properties>
			<string name="Name">Client</string>
			<ProtectedString name="Source"><![CDATA[-- Client entry point: wires up the HUD, movement, weapons, effects,
-- third-person posing and spectating.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local StarterGui = game:GetService("StarterGui")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)
local Util = require(Shared.Util)

local HUD = require(script.HUD)
local Effects = require(script.Effects)
local Movement = require(script.Movement)
local CameraFX = require(script.CameraFX)
local WeaponController = require(script.WeaponController)
local ThirdPerson = require(script.ThirdPerson)

local player = Players.LocalPlayer

-- Hide the default backpack and health bar; we draw our own.
local function disableCoreGui()
	for _ = 1, 10 do
		local ok = pcall(function()
			StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
			StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Health, false)
		end)
		if ok then
			return
		end
		task.wait(0.5)
	end
end
task.spawn(disableCoreGui)

-- Runs a startup step; a failure is reported in Output but doesn't stop the
-- rest of the client from starting.
local function safe(name, fn, ...)
	local ok, err = pcall(fn, ...)
	if not ok then
		warn("[ArenaFPS] " .. name .. " failed: " .. tostring(err))
	end
	return ok
end

safe("CameraMode", function()
	player.CameraMode = Enum.CameraMode.LockFirstPerson
end)
-- Shift is sprint, so turn off shift-lock. Not every client allows this to be
-- set from a LocalScript, hence the pcall (the place file also disables it).
safe("DevEnableMouseLock", function()
	player.DevEnableMouseLock = false
end)

safe("HUD", HUD.init)
safe("Movement", Movement.init)
safe("WeaponController", WeaponController.init)

Effects.onExplosionNearby = function(strength)
	if strength > 0 then
		CameraFX.shake(strength * 10)
	end
end

---------------------------------------------------------------------------
-- Server events
---------------------------------------------------------------------------

Net.get("ShotReplicate").OnClientEvent:Connect(Effects.remoteShot)
Net.get("MeleeReplicate").OnClientEvent:Connect(Effects.remoteMelee)
Net.get("Explosion").OnClientEvent:Connect(Effects.explosion)
Net.get("KillFeed").OnClientEvent:Connect(HUD.killFeed)
Net.get("Flash").OnClientEvent:Connect(HUD.flash)
Net.get("Announce").OnClientEvent:Connect(HUD.announce)

---------------------------------------------------------------------------
-- Match HUD
---------------------------------------------------------------------------

local matchState = Net.matchState()

local function refreshMatch()
	HUD.setMatch(
		matchState:GetAttribute("State") or "Waiting",
		matchState:GetAttribute("Round") or 0,
		matchState:GetAttribute("RedScore") or 0,
		matchState:GetAttribute("BlueScore") or 0,
		matchState:GetAttribute("TimeLeft") or 0
	)

	local state = matchState:GetAttribute("State")
	if player.Team == nil and (state == "Waiting" or state == "Intermission") then
		HUD.setHint("M Loadout  ·  1-4 / Wheel Weapons  ·  G Grenade  ·  R Reload  ·  Shift Sprint  ·  Ctrl Crouch/Slide")
	elseif player.Team == nil then
		HUD.setHint("Match in progress - you'll join the next one. Practise on the dummies.")
	else
		HUD.setHint("")
	end
end

matchState.AttributeChanged:Connect(refreshMatch)
player:GetPropertyChangedSignal("Team"):Connect(refreshMatch)
refreshMatch()

---------------------------------------------------------------------------
-- Spectating teammates after death during a round
---------------------------------------------------------------------------

local spectateTarget

local function stopSpectating()
	if spectateTarget then
		spectateTarget = nil
		HUD.setSpectating(nil)
	end
	if player.CameraMode ~= Enum.CameraMode.LockFirstPerson then
		player.CameraMode = Enum.CameraMode.LockFirstPerson
	end
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local camera = workspace.CurrentCamera
	if humanoid and camera.CameraSubject ~= humanoid then
		camera.CameraSubject = humanoid
	end
end

local function pickSpectateTarget()
	local fallback
	for _, other in Players:GetPlayers() do
		if other ~= player and other.Team ~= nil and Util.isAlive(other.Character) then
			if other.Team == player.Team then
				return other
			end
			fallback = fallback or other
		end
	end
	return fallback
end

local function updateSpectate()
	local state = matchState:GetAttribute("State")
	local inRound = state == "Round" or state == "RoundStart"
	local alive = Util.isAlive(player.Character)

	if alive or not inRound or player.Team == nil then
		if spectateTarget or player.CameraMode ~= Enum.CameraMode.LockFirstPerson then
			stopSpectating()
		end
		return
	end

	if not spectateTarget or not Util.isAlive(spectateTarget.Character) then
		spectateTarget = pickSpectateTarget()
		if not spectateTarget then
			HUD.setSpectating(nil)
			return
		end
		player.CameraMode = Enum.CameraMode.Classic
		player.CameraMinZoomDistance = 8
		local humanoid = spectateTarget.Character:FindFirstChildOfClass("Humanoid")
		workspace.CurrentCamera.CameraSubject = humanoid
		HUD.setSpectating(spectateTarget.DisplayName)
	end
end

player.CharacterAdded:Connect(function()
	player.CameraMinZoomDistance = 0.5
	stopSpectating()
end)

task.spawn(function()
	while true do
		updateSpectate()
		task.wait(0.5)
	end
end)

---------------------------------------------------------------------------
-- Frame loop: after Roblox's camera has updated
---------------------------------------------------------------------------

RunService:BindToRenderStep("ArenaFPS", Enum.RenderPriority.Camera.Value + 1, function(dt)
	Movement.update(dt)
	WeaponController.update(dt)
	ThirdPerson.update(dt)
end)
]]></ProtectedString>
		</Properties>
		<Item class="ModuleScript" referent="RBX00000026">
			<Properties>
				<string name="Name">CameraFX</string>
				<ProtectedString name="Source"><![CDATA[-- CameraFX: recoil kick, view bob, slide tilt and FOV changes.
-- Runs right after Roblox's camera update each frame.
--
-- Pitch/yaw recoil is applied as a per-frame *delta*: Roblox's camera reads
-- its own CFrame back each frame, so the kick climbs while you spray and
-- settles back down as the spring returns to zero.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Spring = require(Shared.Spring)
local Util = require(Shared.Util)

local CameraFX = {}

local player = Players.LocalPlayer

local recoil = Spring.new(Vector3.zero, 160, 18)
local applied = Vector3.zero
local shakeApplied = Vector3.zero
local shake = Spring.new(Vector3.zero, 220, 14)
local bobTime = 0
local bobAmount = 0
local roll = 0
local fov = Config.Camera.DefaultFOV

-- Kick the view by `pitch` / `yaw` degrees.
function CameraFX.kick(pitch, yaw)
	recoil.Position += Vector3.new(math.rad(pitch), math.rad(yaw), 0)
end

-- Short random shake (explosions, getting hit).
function CameraFX.shake(strength)
	local rng = Random.new()
	shake:Impulse(Vector3.new(rng:NextNumber(-1, 1), rng:NextNumber(-1, 1), rng:NextNumber(-1, 1)) * strength)
end

-- ctx: { TargetFOV, Speed, Grounded, Sprinting, Sliding, AdsAlpha }
function CameraFX.update(dt, ctx)
	local camera = workspace.CurrentCamera
	if not camera then
		return
	end

	-- Recoil (delta so it doesn't fight mouse input).
	local offset = recoil:Update(dt)
	local delta = offset - applied
	applied = offset

	local character = player.Character
	local alive = Util.isAlive(character)

	-- View bob scales with ground speed and fades while aiming.
	local speed = ctx.Speed or 0
	local moving = alive and ctx.Grounded and speed > 1 and not ctx.Sliding
	local targetBob = 0
	if moving then
		targetBob = (ctx.Sprinting and Config.Camera.BobSprint or Config.Camera.BobWalk) * (1 - 0.85 * (ctx.AdsAlpha or 0))
	end
	bobAmount = Util.approach(bobAmount, targetBob, 10, dt)
	bobTime += dt * math.clamp(speed / 16, 0.5, 1.8) * 9

	local bobX = math.sin(bobTime * 0.5) * bobAmount
	local bobY = math.abs(math.cos(bobTime * 0.5)) * bobAmount * 0.8

	-- Lean into slides.
	roll = Util.approach(roll, ctx.Sliding and math.rad(-6) or 0, 8, dt)

	-- Shake pitch/yaw is also applied as a delta; roll is rebuilt each frame
	-- by Roblox's camera so it can be applied in full.
	local shakeOffset = shake:Update(dt) * 0.02
	local shakeDelta = shakeOffset - shakeApplied
	shakeApplied = shakeOffset

	if alive then
		camera.CFrame = camera.CFrame
			* CFrame.Angles(delta.X + shakeDelta.X, delta.Y + shakeDelta.Y, 0)
			* CFrame.new(bobX, bobY, 0)
			* CFrame.Angles(0, 0, roll + shakeOffset.Z)
	end

	fov = Util.approach(fov, ctx.TargetFOV or Config.Camera.DefaultFOV, 14, dt)
	camera.FieldOfView = fov
end

function CameraFX.reset()
	recoil:Reset(Vector3.zero)
	shake:Reset(Vector3.zero)
	applied = Vector3.zero
	shakeApplied = Vector3.zero
	roll = 0
end

return CameraFX
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX00000027">
			<Properties>
				<string name="Name">Effects</string>
				<ProtectedString name="Source"><![CDATA[-- Effects: tracers, muzzle flashes, impacts, explosions and sounds.
-- All client-side, so they cost the server nothing.

local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)

local Effects = {}

local player = Players.LocalPlayer
local folder

local TRACER_COLOR = Color3.fromRGB(255, 220, 140)
local FLASH_COLOR = Color3.fromRGB(255, 190, 90)

local function getFolder()
	if not folder or not folder.Parent then
		folder = Instance.new("Folder")
		folder.Name = "ClientFX"
		folder.Parent = workspace.CurrentCamera
	end
	return folder
end

local function basicPart(size, cframe, color, material)
	local part = Instance.new("Part")
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.Size = size
	part.CFrame = cframe
	part.Color = color
	part.Material = material or Enum.Material.Neon
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Parent = getFolder()
	return part
end

---------------------------------------------------------------------------
-- Sound
---------------------------------------------------------------------------

-- Plays a sound by key from Config.Sounds.
--   where: nil (2D, heard everywhere) or a Vector3 (3D at that point)
function Effects.sound(key, where, volume, speed)
	local id = Config.Sounds[key]
	if not id or id == "" then
		return
	end

	local sound = Instance.new("Sound")
	sound.SoundId = id
	sound.Volume = volume or 0.6
	sound.PlaybackSpeed = (speed or 1) * (0.95 + math.random() * 0.1)

	if typeof(where) == "Vector3" then
		local attachment = Instance.new("Attachment")
		attachment.WorldPosition = where
		attachment.Parent = workspace.Terrain
		sound.RollOffMaxDistance = 400
		sound.RollOffMinDistance = 10
		sound.Parent = attachment
		sound:Play()
		Debris:AddItem(attachment, 4)
	else
		sound.Parent = getFolder()
		sound:Play()
		Debris:AddItem(sound, 4)
	end
end

---------------------------------------------------------------------------
-- Guns
---------------------------------------------------------------------------

function Effects.tracer(from, to, color)
	local offset = to - from
	local length = offset.Magnitude
	if length < 1 then
		return
	end
	local part = basicPart(
		Vector3.new(0.06, 0.06, math.min(length, 60)),
		CFrame.lookAt(from + offset.Unit * math.min(length, 60) / 2, to),
		color or TRACER_COLOR
	)
	part.Transparency = 0.2

	-- Slide the streak along the bullet path, then fade.
	local travel = math.min(0.08, length / 1500)
	TweenService:Create(part, TweenInfo.new(travel + 0.05, Enum.EasingStyle.Linear), {
		CFrame = CFrame.lookAt(to - offset.Unit * math.min(length, 60) / 2, to + offset.Unit),
		Transparency = 1,
	}):Play()
	Debris:AddItem(part, travel + 0.1)
end

function Effects.muzzleFlash(position, direction, scale)
	scale = scale or 1
	local cf = CFrame.lookAt(position, position + direction)
	local flash = basicPart(Vector3.new(0.35, 0.35, 0.6) * scale, cf * CFrame.new(0, 0, -0.2 * scale), FLASH_COLOR)
	flash.Shape = Enum.PartType.Ball
	flash.Transparency = 0.1

	local light = Instance.new("PointLight")
	light.Color = FLASH_COLOR
	light.Brightness = 4
	light.Range = 10 * scale
	light.Parent = flash

	local spike = basicPart(Vector3.new(0.12, 0.12, 0.9) * scale, cf * CFrame.new(0, 0, -0.45 * scale), Color3.fromRGB(255, 240, 200))
	spike.Transparency = 0.2

	Debris:AddItem(flash, 0.05)
	Debris:AddItem(spike, 0.04)
end

function Effects.impact(position, normal, flesh)
	normal = normal or Vector3.yAxis
	local color = flesh and Color3.fromRGB(190, 30, 30) or Color3.fromRGB(220, 210, 190)
	local cf = CFrame.lookAt(position, position + normal)

	local mark = basicPart(Vector3.new(0.25, 0.25, 0.05), cf, flesh and color or Color3.fromRGB(30, 30, 30), Enum.Material.SmoothPlastic)
	mark.Transparency = flesh and 0.2 or 0.1
	TweenService:Create(mark, TweenInfo.new(flesh and 0.3 or 4, Enum.EasingStyle.Linear), { Transparency = 1 }):Play()
	Debris:AddItem(mark, flesh and 0.35 or 4.1)

	-- A few sparks / blood bits flying off the surface.
	for _ = 1, flesh and 4 or 3 do
		local spread = Vector3.new(math.random() - 0.5, math.random() - 0.5, math.random() - 0.5) * 1.2
		local dir = (normal + spread).Unit
		local bit = basicPart(Vector3.new(0.08, 0.08, 0.08), CFrame.new(position), color)
		TweenService:Create(bit, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			CFrame = CFrame.new(position + dir * (0.8 + math.random())),
			Transparency = 1,
		}):Play()
		Debris:AddItem(bit, 0.3)
	end
end

-- Another player fired: draw tracers from their gun and play the shot.
function Effects.remoteShot(shooter, weaponId, origin, points)
	local weapon = Config.getWeapon(weaponId)
	local muzzlePosition = origin
	local character = shooter and shooter.Character
	local model = character and character:FindFirstChild("WorldWeapon")
	local handle = model and model.PrimaryPart
	local muzzle = handle and handle:FindFirstChild("Muzzle")
	if muzzle then
		muzzlePosition = muzzle.WorldPosition
	end

	for _, point in points do
		Effects.tracer(muzzlePosition, point)
		Effects.impact(point, (muzzlePosition - point).Unit, false)
	end
	local first = points[1]
	if first then
		Effects.muzzleFlash(muzzlePosition, (first - muzzlePosition).Unit, 0.8)
	end
	if weapon and weapon.Sound then
		Effects.sound(weapon.Sound, muzzlePosition, 0.9)
	end
end

function Effects.remoteMelee(attacker)
	local character = attacker and attacker.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if root then
		Effects.sound("Swing", root.Position, 0.6)
	end
end

---------------------------------------------------------------------------
-- Grenades
---------------------------------------------------------------------------

function Effects.explosion(position, radius, kind)
	if kind == "Flash" then
		local pop = basicPart(Vector3.one * 2, CFrame.new(position), Color3.new(1, 1, 1))
		pop.Shape = Enum.PartType.Ball
		local light = Instance.new("PointLight")
		light.Brightness = 10
		light.Range = 40
		light.Parent = pop
		TweenService:Create(pop, TweenInfo.new(0.25), { Size = Vector3.one * 10, Transparency = 1 }):Play()
		Debris:AddItem(pop, 0.3)
		Effects.sound("Hitmarker", position, 1.5, 0.5)
		return
	end

	-- Roblox Explosion for the built-in sound and particles, with no physics.
	local explosion = Instance.new("Explosion")
	explosion.Position = position
	explosion.BlastRadius = radius * 0.5
	explosion.BlastPressure = 0
	explosion.DestroyJointRadiusPercent = 0
	explosion.ExplosionType = Enum.ExplosionType.NoCraters
	explosion.Parent = workspace

	local fireball = basicPart(Vector3.one * 2, CFrame.new(position), Color3.fromRGB(255, 150, 50))
	fireball.Shape = Enum.PartType.Ball
	TweenService:Create(fireball, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Size = Vector3.one * radius * 1.2,
		Transparency = 1,
		Color = Color3.fromRGB(80, 60, 50),
	}):Play()
	Debris:AddItem(fireball, 0.4)

	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if root then
		local distance = (root.Position - position).Magnitude
		Effects.onExplosionNearby(math.clamp(1 - distance / (radius * 3), 0, 1))
	end
end

-- Replaced by the client entry to shake the camera.
Effects.onExplosionNearby = function(_strength) end

function Effects.clear()
	if folder then
		folder:ClearAllChildren()
	end
end

return Effects
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX00000028">
			<Properties>
				<string name="Name">HUD</string>
				<ProtectedString name="Source"><![CDATA[-- HUD: crosshair, hitmarkers, health, ammo, weapon slots, match score,
-- announcements, kill feed, damage indicators, sniper scope, flash overlay
-- and the loadout menu. Everything is built in code.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Net = require(Shared.Net)
local Util = require(Shared.Util)

local HUD = {}

local player = Players.LocalPlayer

local WHITE = Color3.new(1, 1, 1)
local DIM = Color3.fromRGB(160, 165, 175)
local PANEL = Color3.fromRGB(14, 15, 20)
local ACCENT = Color3.fromRGB(255, 190, 60)
local RED = Color3.fromRGB(235, 70, 70)
local BLUE = Color3.fromRGB(70, 140, 255)
local HEAD = Color3.fromRGB(255, 200, 60)
local FONT = Enum.Font.GothamBold
local FONT_LIGHT = Enum.Font.GothamMedium

local gui
local refs = {}
local menuOpen = false
local hitmarkerTime = -10
local hitmarkerColor = WHITE
local crosshairGap = 10
local damageIndicators = {}

---------------------------------------------------------------------------
-- Builders
---------------------------------------------------------------------------

local function new(className, props, children)
	local instance = Instance.new(className)
	for key, value in props do
		if key ~= "Parent" then
			instance[key] = value
		end
	end
	if children then
		for _, child in children do
			child.Parent = instance
		end
	end
	if props.Parent then
		instance.Parent = props.Parent
	end
	return instance
end

local function corner(radius)
	return new("UICorner", { CornerRadius = UDim.new(0, radius or 6) })
end

local function stroke(thickness, color, transparency)
	return new("UIStroke", {
		Thickness = thickness or 1,
		Color = color or Color3.new(0, 0, 0),
		Transparency = transparency or 0.5,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
end

local function label(props)
	props.BackgroundTransparency = props.BackgroundTransparency or 1
	props.TextColor3 = props.TextColor3 or WHITE
	props.Font = props.Font or FONT
	props.TextScaled = props.TextScaled or false
	props.TextSize = props.TextSize or 18
	return new("TextLabel", props)
end

local function textStroke(instance)
	instance.TextStrokeTransparency = 0.6
	instance.TextStrokeColor3 = Color3.new(0, 0, 0)
	return instance
end

---------------------------------------------------------------------------
-- Construction
---------------------------------------------------------------------------

local function buildCrosshair(parent)
	local holder = new("Frame", {
		Name = "Crosshair",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(0, 0),
		BackgroundTransparency = 1,
		Parent = parent,
	})
	refs.CrosshairLines = {}
	for i, dir in { Vector2.new(0, -1), Vector2.new(0, 1), Vector2.new(-1, 0), Vector2.new(1, 0) } do
		local vertical = dir.X == 0
		local line = new("Frame", {
			Name = "Line" .. i,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Size = vertical and UDim2.fromOffset(2, 8) or UDim2.fromOffset(8, 2),
			BackgroundColor3 = WHITE,
			BorderSizePixel = 0,
			Parent = holder,
		}, { stroke(1, Color3.new(0, 0, 0), 0.4) })
		refs.CrosshairLines[i] = { Frame = line, Direction = dir }
	end
	refs.CrosshairDot = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(3, 3),
		BackgroundColor3 = WHITE,
		BorderSizePixel = 0,
		Parent = holder,
	}, { corner(2) })
	refs.Crosshair = holder

	-- Hitmarker: four diagonal ticks.
	local marker = new("Frame", {
		Name = "Hitmarker",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(0, 0),
		BackgroundTransparency = 1,
		Parent = parent,
	})
	refs.HitmarkerLines = {}
	for i, angle in { 45, 135, 225, 315 } do
		local r = math.rad(angle)
		local line = new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset(math.cos(r) * 12, math.sin(r) * 12),
			Size = UDim2.fromOffset(10, 2),
			Rotation = angle,
			BackgroundColor3 = WHITE,
			BorderSizePixel = 0,
			BackgroundTransparency = 1,
			Parent = marker,
		})
		refs.HitmarkerLines[i] = line
	end
end

local function buildBottom(parent)
	-- Health (bottom left).
	local health = new("Frame", {
		Name = "Health",
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 24, 1, -24),
		Size = UDim2.fromOffset(280, 54),
		BackgroundColor3 = PANEL,
		BackgroundTransparency = 0.35,
		Parent = parent,
	}, { corner(8) })
	refs.HealthText = textStroke(label({
		Position = UDim2.fromOffset(14, 4),
		Size = UDim2.fromOffset(80, 30),
		Text = "100",
		TextSize = 28,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = health,
	}))
	label({
		Position = UDim2.fromOffset(72, 10),
		Size = UDim2.fromOffset(60, 20),
		Text = "HP",
		TextColor3 = DIM,
		TextSize = 14,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = health,
	})
	local barBack = new("Frame", {
		Position = UDim2.new(0, 14, 1, -16),
		Size = UDim2.new(1, -28, 0, 8),
		BackgroundColor3 = Color3.fromRGB(40, 42, 50),
		BorderSizePixel = 0,
		Parent = health,
	}, { corner(4) })
	refs.HealthBar = new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.fromRGB(110, 230, 120),
		BorderSizePixel = 0,
		Parent = barBack,
	}, { corner(4) })

	-- Ammo + weapon name (bottom right).
	local ammo = new("Frame", {
		Name = "Ammo",
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -24, 1, -24),
		Size = UDim2.fromOffset(260, 74),
		BackgroundColor3 = PANEL,
		BackgroundTransparency = 0.35,
		Parent = parent,
	}, { corner(8) })
	refs.WeaponName = textStroke(label({
		Position = UDim2.fromOffset(14, 6),
		Size = UDim2.new(1, -28, 0, 20),
		Text = "",
		TextSize = 16,
		TextColor3 = ACCENT,
		TextXAlignment = Enum.TextXAlignment.Right,
		Parent = ammo,
	}))
	refs.AmmoText = textStroke(label({
		Position = UDim2.fromOffset(14, 26),
		Size = UDim2.new(1, -28, 0, 40),
		Text = "",
		TextSize = 34,
		RichText = true,
		TextXAlignment = Enum.TextXAlignment.Right,
		Parent = ammo,
	}))

	-- Weapon slots above the ammo panel.
	local slots = new("Frame", {
		Name = "Slots",
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -24, 1, -106),
		Size = UDim2.fromOffset(260, 140),
		BackgroundTransparency = 1,
		Parent = parent,
	}, {
		new("UIListLayout", {
			Padding = UDim.new(0, 4),
			VerticalAlignment = Enum.VerticalAlignment.Bottom,
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	refs.Slots = {}
	for i, slotName in Config.SlotOrder do
		local frame = new("Frame", {
			Name = slotName,
			LayoutOrder = i,
			Size = UDim2.new(1, 0, 0, 30),
			BackgroundColor3 = PANEL,
			BackgroundTransparency = 0.5,
			Parent = slots,
		}, { corner(6) })
		local key = label({
			Position = UDim2.fromOffset(8, 0),
			Size = UDim2.fromOffset(20, 30),
			Text = tostring(i),
			TextColor3 = DIM,
			TextSize = 14,
			Parent = frame,
		})
		local name = label({
			Position = UDim2.fromOffset(32, 0),
			Size = UDim2.new(1, -40, 1, 0),
			Text = "",
			TextSize = 15,
			TextXAlignment = Enum.TextXAlignment.Left,
			Font = FONT_LIGHT,
			Parent = frame,
		})
		refs.Slots[slotName] = { Frame = frame, Key = key, Name = name }
	end

	-- Hint line.
	refs.Hint = textStroke(label({
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -18),
		Size = UDim2.fromOffset(600, 20),
		Text = "",
		TextSize = 14,
		TextColor3 = DIM,
		Font = FONT_LIGHT,
		Parent = parent,
	}))
end

local function buildTop(parent)
	local bar = new("Frame", {
		Name = "Score",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 14),
		Size = UDim2.fromOffset(300, 56),
		BackgroundColor3 = PANEL,
		BackgroundTransparency = 0.35,
		Parent = parent,
	}, { corner(8) })
	refs.RedScore = textStroke(label({
		Position = UDim2.fromOffset(10, 4),
		Size = UDim2.fromOffset(70, 48),
		Text = "0",
		TextSize = 34,
		TextColor3 = RED,
		Parent = bar,
	}))
	refs.BlueScore = textStroke(label({
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -10, 0, 4),
		Size = UDim2.fromOffset(70, 48),
		Text = "0",
		TextSize = 34,
		TextColor3 = BLUE,
		Parent = bar,
	}))
	refs.Timer = textStroke(label({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 4),
		Size = UDim2.fromOffset(140, 28),
		Text = "",
		TextSize = 24,
		Parent = bar,
	}))
	refs.StateText = label({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 31),
		Size = UDim2.fromOffset(160, 18),
		Text = "",
		TextSize = 13,
		TextColor3 = DIM,
		Font = FONT_LIGHT,
		Parent = bar,
	})

	-- Big centre announcement.
	refs.Announce = textStroke(label({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.3),
		Size = UDim2.fromOffset(900, 80),
		Text = "",
		TextSize = 64,
		TextTransparency = 1,
		TextStrokeTransparency = 1,
		Parent = parent,
	}))
	refs.AnnounceSub = textStroke(label({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.3, 54),
		Size = UDim2.fromOffset(900, 30),
		Text = "",
		TextSize = 22,
		TextColor3 = DIM,
		TextTransparency = 1,
		TextStrokeTransparency = 1,
		Parent = parent,
	}))

	-- Kill feed (top right).
	refs.KillFeed = new("Frame", {
		Name = "KillFeed",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -20, 0, 20),
		Size = UDim2.fromOffset(380, 200),
		BackgroundTransparency = 1,
		Parent = parent,
	}, {
		new("UIListLayout", {
			Padding = UDim.new(0, 4),
			HorizontalAlignment = Enum.HorizontalAlignment.Right,
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})

	-- Spectating label.
	refs.Spectate = textStroke(label({
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -110),
		Size = UDim2.fromOffset(500, 30),
		Text = "",
		TextSize = 22,
		Visible = false,
		Parent = parent,
	}))
end

local function buildOverlays(parent)
	-- Sniper scope: black surround with a round window and a reticle.
	local scope = new("Frame", {
		Name = "Scope",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Visible = false,
		ZIndex = 5,
		Parent = parent,
	})
	local window = new("Frame", {
		Name = "Window",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(0.9, 0.9),
		SizeConstraint = Enum.SizeConstraint.RelativeYY,
		BackgroundTransparency = 1,
		ZIndex = 5,
		Parent = scope,
	})
	-- Circle edge: a round frame with a very thick black stroke covers the
	-- corners of the square window.
	new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		ZIndex = 5,
		Parent = window,
	}, {
		new("UICorner", { CornerRadius = UDim.new(0.5, 0) }),
		new("UIStroke", { Thickness = 400, Color = Color3.new(0, 0, 0) }),
	})
	for _, info in {
		{ Vector2.new(1, 0.5), UDim2.new(0, 0, 0.5, 0) },
		{ Vector2.new(0, 0.5), UDim2.new(1, 0, 0.5, 0) },
	} do
		new("Frame", {
			AnchorPoint = info[1],
			Position = info[2],
			Size = UDim2.new(5, 0, 5, 0),
			BackgroundColor3 = Color3.new(0, 0, 0),
			BorderSizePixel = 0,
			ZIndex = 5,
			Parent = window,
		})
	end
	new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(1, 0, 0, 1),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BorderSizePixel = 0,
		ZIndex = 6,
		Parent = window,
	})
	new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(0, 1, 1, 0),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BorderSizePixel = 0,
		ZIndex = 6,
		Parent = window,
	})
	new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(4, 4),
		BackgroundColor3 = Color3.fromRGB(255, 60, 60),
		BorderSizePixel = 0,
		ZIndex = 7,
		Parent = window,
	}, { corner(2) })
	refs.Scope = scope

	-- Flashbang whiteout.
	refs.Flash = new("Frame", {
		Name = "Flash",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = WHITE,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ZIndex = 20,
		Parent = parent,
	})

	-- Red vignette when hurt.
	refs.Hurt = new("Frame", {
		Name = "Hurt",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.fromRGB(150, 0, 0),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ZIndex = 4,
		Parent = parent,
	})

	-- Holder for directional damage arcs.
	refs.DamageHolder = new("Frame", {
		Name = "DamageIndicators",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(0, 0),
		BackgroundTransparency = 1,
		Parent = parent,
	})
end

local function buildLoadoutMenu(parent)
	local menu = new("Frame", {
		Name = "Loadout",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(820, 420),
		BackgroundColor3 = PANEL,
		BackgroundTransparency = 0.1,
		Visible = false,
		ZIndex = 30,
		Parent = parent,
	}, { corner(12), stroke(2, ACCENT, 0.3) })

	label({
		Position = UDim2.fromOffset(24, 14),
		Size = UDim2.new(1, -48, 0, 36),
		Text = "LOADOUT",
		TextSize = 30,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 31,
		Parent = menu,
	})
	refs.MenuNote = label({
		Position = UDim2.fromOffset(24, 48),
		Size = UDim2.new(1, -48, 0, 20),
		Text = "Changes apply instantly in the lobby, or on your next spawn in a match.",
		TextSize = 14,
		TextColor3 = DIM,
		Font = FONT_LIGHT,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 31,
		Parent = menu,
	})

	-- A full-size invisible modal button frees the mouse in first person.
	new("TextButton", {
		Name = "Modal",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Text = "",
		Modal = true,
		ZIndex = 30,
		Parent = menu,
	})

	refs.MenuButtons = {}
	refs.Selection = table.clone(Config.DefaultLoadout)

	local columnWidth = 190
	for column, slotName in Config.SlotOrder do
		local x = 24 + (column - 1) * (columnWidth + 8)
		label({
			Position = UDim2.fromOffset(x, 82),
			Size = UDim2.fromOffset(columnWidth, 22),
			Text = string.upper(slotName),
			TextSize = 15,
			TextColor3 = ACCENT,
			TextXAlignment = Enum.TextXAlignment.Left,
			ZIndex = 31,
			Parent = menu,
		})
		refs.MenuButtons[slotName] = {}
		for row, weaponId in Config.LoadoutOptions[slotName] do
			local weapon = Config.getWeapon(weaponId)
			local button = new("TextButton", {
				Name = weaponId,
				Position = UDim2.fromOffset(x, 108 + (row - 1) * 60),
				Size = UDim2.fromOffset(columnWidth, 52),
				BackgroundColor3 = Color3.fromRGB(36, 38, 48),
				AutoButtonColor = true,
				Text = "",
				ZIndex = 31,
				Parent = menu,
			}, { corner(8) })
			label({
				Position = UDim2.fromOffset(12, 6),
				Size = UDim2.new(1, -24, 0, 22),
				Text = weapon.DisplayName,
				TextSize = 17,
				TextXAlignment = Enum.TextXAlignment.Left,
				ZIndex = 32,
				Parent = button,
			})
			local detail
			if weapon.Kind == "Gun" then
				detail = string.format("%d dmg  ·  %d rpm  ·  %d mag", weapon.Damage * weapon.Pellets, weapon.RPM, weapon.MagSize)
			elseif weapon.Kind == "Melee" then
				detail = string.format("%d dmg  ·  %.1fs swing", weapon.Damage, weapon.Cooldown)
			else
				detail = string.format("%d charge%s", weapon.Charges, weapon.Charges == 1 and "" or "s")
			end
			label({
				Position = UDim2.fromOffset(12, 28),
				Size = UDim2.new(1, -24, 0, 18),
				Text = detail,
				TextSize = 12,
				TextColor3 = DIM,
				Font = FONT_LIGHT,
				TextXAlignment = Enum.TextXAlignment.Left,
				ZIndex = 32,
				Parent = button,
			})
			local outline = stroke(2, ACCENT, 1)
			outline.Parent = button
			refs.MenuButtons[slotName][weaponId] = outline

			button.MouseButton1Click:Connect(function()
				refs.Selection[slotName] = weaponId
				HUD.refreshMenu()
				Net.get("SetLoadout"):FireServer(refs.Selection)
			end)
		end
	end

	local close = new("TextButton", {
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -24, 1, -18),
		Size = UDim2.fromOffset(140, 40),
		BackgroundColor3 = ACCENT,
		Text = "DONE  (M)",
		TextColor3 = PANEL,
		Font = FONT,
		TextSize = 16,
		ZIndex = 31,
		Parent = menu,
	}, { corner(8) })
	close.MouseButton1Click:Connect(function()
		HUD.setMenuOpen(false)
	end)

	refs.Menu = menu
	HUD.refreshMenu()
end

---------------------------------------------------------------------------
-- Public API
---------------------------------------------------------------------------

function HUD.init()
	gui = new("ScreenGui", {
		Name = "ArenaHUD",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = player:WaitForChild("PlayerGui"),
	})
	buildCrosshair(gui)
	buildBottom(gui)
	buildTop(gui)
	buildOverlays(gui)
	buildLoadoutMenu(gui)
end

function HUD.refreshMenu()
	for slotName, outlines in refs.MenuButtons do
		for weaponId, outline in outlines do
			outline.Transparency = refs.Selection[slotName] == weaponId and 0 or 1
		end
	end
end

function HUD.isMenuOpen()
	return menuOpen
end

function HUD.setMenuOpen(open)
	menuOpen = open
	refs.Menu.Visible = open
end

function HUD.toggleMenu()
	HUD.setMenuOpen(not menuOpen)
end

-- Called every frame by the weapon controller.
-- info: { Spread (degrees), AdsAlpha, Kind, Scoped, Hidden }
function HUD.updateCrosshair(dt, info)
	local camera = workspace.CurrentCamera
	local viewport = camera.ViewportSize
	local halfFov = math.rad(camera.FieldOfView / 2)
	local targetGap = math.tan(math.rad(info.Spread or 0)) / math.tan(halfFov) * (viewport.Y / 2)
	targetGap = math.clamp(targetGap, 4, 120)
	crosshairGap = Util.approach(crosshairGap, targetGap, 20, dt)

	local hidden = info.Hidden or info.Scoped or (info.Kind == "Gun" and (info.AdsAlpha or 0) > 0.6)
	refs.Crosshair.Visible = not hidden
	for _, line in refs.CrosshairLines do
		local vertical = line.Direction.X == 0
		local offset = line.Direction * (crosshairGap + 4)
		line.Frame.Position = UDim2.fromOffset(offset.X, offset.Y)
		line.Frame.Visible = info.Kind == "Gun"
		line.Frame.Size = vertical and UDim2.fromOffset(2, 8) or UDim2.fromOffset(8, 2)
	end

	refs.Scope.Visible = info.Scoped == true

	-- Hitmarker fade.
	local age = os.clock() - hitmarkerTime
	local alpha = math.clamp(age / 0.3, 0, 1)
	for _, line in refs.HitmarkerLines do
		line.BackgroundTransparency = alpha
		line.BackgroundColor3 = hitmarkerColor
	end

	-- Damage indicators fade.
	for i = #damageIndicators, 1, -1 do
		local indicator = damageIndicators[i]
		local life = os.clock() - indicator.Start
		if life > 1.5 then
			indicator.Frame:Destroy()
			table.remove(damageIndicators, i)
		else
			-- Keep pointing at the source as the camera turns.
			local look = camera.CFrame.LookVector
			local toSource = indicator.Source - camera.CFrame.Position
			local angle = math.atan2(toSource.X, toSource.Z) - math.atan2(look.X, look.Z)
			indicator.Frame.Rotation = -math.deg(angle)
			indicator.Bar.BackgroundTransparency = 0.2 + 0.8 * (life / 1.5)
		end
	end
end

function HUD.hitmarker(headshot, killed)
	hitmarkerTime = os.clock()
	hitmarkerColor = killed and RED or (headshot and HEAD or WHITE)
	local size = killed and 14 or 10
	for _, line in refs.HitmarkerLines do
		line.Size = UDim2.fromOffset(size, killed and 3 or 2)
	end
end

function HUD.damageFrom(sourcePosition)
	if typeof(sourcePosition) ~= "Vector3" then
		return
	end
	local frame = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(0, 0),
		BackgroundTransparency = 1,
		Parent = refs.DamageHolder,
	})
	local bar = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset(0, -120),
		Size = UDim2.fromOffset(90, 8),
		BackgroundColor3 = Color3.fromRGB(255, 40, 40),
		BorderSizePixel = 0,
		Parent = frame,
	}, { corner(4) })
	table.insert(damageIndicators, { Frame = frame, Bar = bar, Source = sourcePosition, Start = os.clock() })

	refs.Hurt.BackgroundTransparency = 0.7
	TweenService:Create(refs.Hurt, TweenInfo.new(0.5), { BackgroundTransparency = 1 }):Play()
end

function HUD.setHealth(health, maxHealth)
	local ratio = maxHealth > 0 and math.clamp(health / maxHealth, 0, 1) or 0
	refs.HealthText.Text = tostring(math.ceil(health))
	refs.HealthBar.Size = UDim2.fromScale(ratio, 1)
	refs.HealthBar.BackgroundColor3 = Color3.fromRGB(235, 70, 70):Lerp(Color3.fromRGB(110, 230, 120), ratio)
end

-- slots: { [slotName] = weaponId }, equipped: slotName
function HUD.setSlots(slots, equipped, charges)
	for slotName, ref in refs.Slots do
		local id = slots[slotName]
		local weapon = id and Config.getWeapon(id)
		local name = weapon and weapon.DisplayName or "-"
		if slotName == "Utility" and weapon then
			name = string.format("%s  x%d", name, charges or 0)
		end
		ref.Name.Text = name
		local active = slotName == equipped
		ref.Frame.BackgroundTransparency = active and 0.15 or 0.55
		ref.Name.TextColor3 = active and ACCENT or WHITE
	end
end

function HUD.setAmmo(weaponName, mag, reserve, reloading)
	refs.WeaponName.Text = string.upper(weaponName or "")
	if mag == nil then
		refs.AmmoText.Text = ""
	elseif reloading then
		refs.AmmoText.Text = '<font color="#ffbe3c">RELOADING</font>'
	else
		local color = mag == 0 and "#eb4646" or "#ffffff"
		refs.AmmoText.Text = string.format('<font color="%s">%d</font> <font size="20" color="#a0a5af">/ %d</font>', color, mag, reserve)
	end
end

function HUD.setHint(text)
	refs.Hint.Text = text or ""
end

function HUD.announce(title, subtitle, duration, color)
	refs.Announce.Text = title
	refs.Announce.TextColor3 = color or WHITE
	refs.AnnounceSub.Text = subtitle or ""
	for _, labelRef in { refs.Announce, refs.AnnounceSub } do
		labelRef.TextTransparency = 0
		labelRef.TextStrokeTransparency = 0.6
	end
	refs.Announce.TextSize = 80
	TweenService:Create(refs.Announce, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { TextSize = 64 }):Play()

	local token = {}
	refs.AnnounceToken = token
	task.delay(duration or 2, function()
		if refs.AnnounceToken ~= token then
			return
		end
		for _, labelRef in { refs.Announce, refs.AnnounceSub } do
			TweenService:Create(labelRef, TweenInfo.new(0.4), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
		end
	end)
end

function HUD.killFeed(killer, victim, weaponName, headshot)
	local text
	if killer == "" then
		text = string.format("%s died", victim)
	else
		text = string.format("%s  [%s%s]  %s", killer, weaponName, headshot and " ✦" or "", victim)
	end
	local involved = killer == player.DisplayName or victim == player.DisplayName

	local entry = new("Frame", {
		Size = UDim2.fromOffset(0, 28),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundColor3 = involved and Color3.fromRGB(60, 50, 20) or PANEL,
		BackgroundTransparency = 0.3,
		LayoutOrder = -math.floor(os.clock() * 100),
		Parent = refs.KillFeed,
	}, {
		corner(6),
		new("UIPadding", { PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10) }),
	})
	label({
		Size = UDim2.fromOffset(0, 28),
		AutomaticSize = Enum.AutomaticSize.X,
		Text = text,
		TextSize = 15,
		TextColor3 = headshot and HEAD or WHITE,
		Parent = entry,
	})

	local children = {}
	for _, child in refs.KillFeed:GetChildren() do
		if child:IsA("Frame") then
			table.insert(children, child)
		end
	end
	if #children > 6 then
		table.sort(children, function(a, b)
			return a.LayoutOrder > b.LayoutOrder
		end)
		children[1]:Destroy()
	end

	task.delay(6, function()
		if entry.Parent then
			entry:Destroy()
		end
	end)
end

function HUD.setMatch(state, round, redScore, blueScore, timeLeft)
	refs.RedScore.Text = tostring(redScore)
	refs.BlueScore.Text = tostring(blueScore)
	if state == "Waiting" then
		refs.Timer.Text = "LOBBY"
		refs.StateText.Text = "Waiting for players"
	elseif state == "Intermission" then
		refs.Timer.Text = tostring(timeLeft)
		refs.StateText.Text = "Match starting"
	elseif state == "RoundStart" then
		refs.Timer.Text = tostring(timeLeft)
		refs.StateText.Text = "Round " .. round
	elseif state == "Round" then
		refs.Timer.Text = Util.formatTime(timeLeft)
		refs.StateText.Text = "Round " .. round
	elseif state == "RoundEnd" then
		refs.Timer.Text = "-"
		refs.StateText.Text = "Round over"
	elseif state == "MatchEnd" then
		refs.Timer.Text = "-"
		refs.StateText.Text = "Match over"
	end
end

function HUD.flash(intensity, duration)
	refs.Flash.BackgroundTransparency = 1 - math.clamp(intensity, 0, 1)
	TweenService:Create(
		refs.Flash,
		TweenInfo.new(duration * intensity, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
		{ BackgroundTransparency = 1 }
	):Play()
end

function HUD.setSpectating(name)
	refs.Spectate.Visible = name ~= nil
	refs.Spectate.Text = name and ("SPECTATING  " .. string.upper(name)) or ""
end

function HUD.setCombatVisible(visible)
	for _, key in { "Crosshair" } do
		if not visible then
			refs[key].Visible = false
		end
	end
	gui.Health.Visible = visible
	gui.Ammo.Visible = visible
	gui.Slots.Visible = visible
end

return HUD
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX00000029">
			<Properties>
				<string name="Name">Movement</string>
				<ProtectedString name="Source"><![CDATA[-- Movement: sprint, crouch and slide on top of the default Roblox controls.
--   Shift        sprint (forward only, cancels aiming)
--   Ctrl / C     crouch; press while sprinting to slide

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)

local Movement = {}

local player = Players.LocalPlayer
local M = Config.Movement

local sprintHeld = false
local crouchHeld = false
local sprinting = false
local crouching = false
local sliding = false
local slideStart = 0
local lastSlide = -10
local slideDirection = Vector3.zero
local slideVelocity
local slideAttachment
local cameraOffsetY = 0
local sprintAlpha = 0

-- Set by WeaponController each frame.
Movement.weaponSpeedMultiplier = 1
Movement.aiming = false
Movement.blockSprint = false

local function getParts()
	local character = player.Character
	if not character then
		return nil, nil
	end
	return character:FindFirstChildOfClass("Humanoid"), character:FindFirstChild("HumanoidRootPart")
end

local function isGrounded(humanoid)
	return humanoid.FloorMaterial ~= Enum.Material.Air
end

local function stopSlide()
	sliding = false
	if slideVelocity then
		slideVelocity:Destroy()
		slideVelocity = nil
	end
	if slideAttachment then
		slideAttachment:Destroy()
		slideAttachment = nil
	end
end

local function startSlide(humanoid, root)
	local direction = humanoid.MoveDirection
	if direction.Magnitude < 0.1 then
		return
	end
	sliding = true
	slideStart = os.clock()
	lastSlide = slideStart
	slideDirection = Vector3.new(direction.X, 0, direction.Z).Unit

	slideAttachment = Instance.new("Attachment")
	slideAttachment.Name = "SlideAttachment"
	slideAttachment.Parent = root

	slideVelocity = Instance.new("LinearVelocity")
	slideVelocity.Name = "SlideVelocity"
	slideVelocity.Attachment0 = slideAttachment
	slideVelocity.RelativeTo = Enum.ActuatorRelativeTo.World
	slideVelocity.VelocityConstraintMode = Enum.VelocityConstraintMode.Plane
	slideVelocity.PrimaryTangentAxis = Vector3.xAxis
	slideVelocity.SecondaryTangentAxis = Vector3.zAxis
	slideVelocity.MaxForce = 60000
	slideVelocity.PlaneVelocity = Vector2.new(slideDirection.X, slideDirection.Z) * M.SlideSpeed
	slideVelocity.Parent = root
end

function Movement.isSprinting()
	return sprinting
end

function Movement.isSliding()
	return sliding
end

function Movement.isCrouching()
	return crouching
end

function Movement.getSprintAlpha()
	return sprintAlpha
end

function Movement.cancelSprint()
	sprinting = false
end

function Movement.update(dt)
	local humanoid, root = getParts()
	if not humanoid or not root or humanoid.Health <= 0 then
		stopSlide()
		sprinting = false
		crouching = false
		return
	end

	local character = player.Character
	local frozen = character:GetAttribute("Frozen") == true
	local grounded = isGrounded(humanoid)
	local moveDirection = humanoid.MoveDirection
	local moving = moveDirection.Magnitude > 0.1

	-- Sprint only when moving roughly forward relative to the camera.
	local camera = workspace.CurrentCamera
	local forward = camera and Vector3.new(camera.CFrame.LookVector.X, 0, camera.CFrame.LookVector.Z) or Vector3.zero
	local movingForward = moving and forward.Magnitude > 0 and moveDirection:Dot(forward.Unit) > 0.35

	sprinting = sprintHeld
		and movingForward
		and not crouchHeld
		and not Movement.aiming
		and not Movement.blockSprint
		and not sliding
		and not frozen

	-- Slides end on time, on jump, or when they lose ground for too long.
	if sliding then
		local elapsed = os.clock() - slideStart
		local alpha = elapsed / M.SlideDuration
		if alpha >= 1 or humanoid.Jump or not crouchHeld then
			stopSlide()
		elseif slideVelocity then
			local speed = Util.lerp(M.SlideSpeed, M.CrouchSpeed, Util.smoothstep(alpha))
			slideVelocity.PlaneVelocity = Vector2.new(slideDirection.X, slideDirection.Z) * speed
		end
	end

	crouching = crouchHeld and not sliding and grounded

	local speed = M.WalkSpeed
	if sprinting then
		speed = M.SprintSpeed
	elseif crouching or sliding then
		speed = M.CrouchSpeed
	end
	if Movement.aiming then
		speed *= 0.7
	end
	speed *= Movement.weaponSpeedMultiplier
	if frozen then
		speed = 0
	end
	humanoid.WalkSpeed = speed

	sprintAlpha = Util.approach(sprintAlpha, sprinting and 1 or 0, 10, dt)

	local targetOffset = 0
	if sliding then
		targetOffset = M.SlideCameraOffset
	elseif crouching then
		targetOffset = M.CrouchCameraOffset
	end
	cameraOffsetY = Util.approach(cameraOffsetY, targetOffset, 12, dt)
	humanoid.CameraOffset = Vector3.new(0, cameraOffsetY, 0)
end

-- Info for the camera and viewmodel.
function Movement.getContext()
	local humanoid, root = getParts()
	if not humanoid or not root then
		return { Speed = 0, Grounded = true, Sprinting = false, Sliding = false }
	end
	local velocity = root.AssemblyLinearVelocity
	return {
		Speed = Vector3.new(velocity.X, 0, velocity.Z).Magnitude,
		Grounded = isGrounded(humanoid),
		Sprinting = sprinting,
		Sliding = sliding,
		Crouching = crouching,
	}
end

function Movement.init()
	UserInputService.InputBegan:Connect(function(input, processed)
		if processed then
			return
		end
		if input.KeyCode == Config.Keys.Sprint then
			sprintHeld = true
		elseif input.KeyCode == Config.Keys.Crouch or input.KeyCode == Config.Keys.CrouchAlt then
			crouchHeld = true
			local humanoid, root = getParts()
			if humanoid and root and sprinting and isGrounded(humanoid) and os.clock() - lastSlide > M.SlideCooldown then
				startSlide(humanoid, root)
			end
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input.KeyCode == Config.Keys.Sprint then
			sprintHeld = false
		elseif input.KeyCode == Config.Keys.Crouch or input.KeyCode == Config.Keys.CrouchAlt then
			crouchHeld = false
		end
	end)

	player.CharacterAdded:Connect(function()
		stopSlide()
		cameraOffsetY = 0
	end)
end

return Movement
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX0000002A">
			<Properties>
				<string name="Name">ThirdPerson</string>
				<ProtectedString name="Source"><![CDATA[-- ThirdPerson: poses other players' arms so they hold their weapon and aim
-- up/down with their camera. Uses the replicated AimPitch attribute.
-- Also hides your own third-person weapon model while in first person.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)

local ThirdPerson = {}

local localPlayer = Players.LocalPlayer
local defaults = setmetatable({}, { __mode = "k" }) -- [Motor6D] = original C0
local smoothedPitch = setmetatable({}, { __mode = "k" }) -- [Model] = number

local function rememberDefault(motor)
	if motor and not defaults[motor] then
		defaults[motor] = motor.C0
	end
	return motor and defaults[motor]
end

local function restore(character)
	local right, left = Util.getShoulders(character)
	for _, motor in { right, left } do
		if motor and defaults[motor] then
			motor.C0 = defaults[motor]
		end
	end
	local upperTorso = character:FindFirstChild("UpperTorso")
	local waist = upperTorso and upperTorso:FindFirstChild("Waist")
	if waist and defaults[waist] then
		waist.C0 = defaults[waist]
	end
end

local function pose(character, dt)
	local weaponId = character:GetAttribute("Equipped")
	local weapon = weaponId and Config.getWeapon(weaponId)
	if not weapon or not Util.isAlive(character) then
		restore(character)
		return
	end

	local target = character:GetAttribute("AimPitch") or 0
	local pitch = Util.approach(smoothedPitch[character] or target, target, 15, dt)
	smoothedPitch[character] = pitch

	local right, left, rig = Util.getShoulders(character)
	local rightDefault = rememberDefault(right)
	local leftDefault = rememberDefault(left)
	local twoHanded = weapon.Kind == "Gun"

	if rig == "R15" then
		local raise = weapon.Kind == "Melee" and math.rad(60) or math.pi / 2
		if right then
			right.C0 = rightDefault * CFrame.Angles(0, math.rad(12), 0) * CFrame.Angles(raise + pitch, 0, 0)
		end
		if left then
			if twoHanded then
				left.C0 = leftDefault * CFrame.Angles(0, math.rad(-45), 0) * CFrame.Angles(raise + pitch, 0, 0)
			else
				left.C0 = leftDefault
			end
		end
		local upperTorso = character:FindFirstChild("UpperTorso")
		local waist = upperTorso and upperTorso:FindFirstChild("Waist")
		if waist then
			local waistDefault = rememberDefault(waist)
			waist.C0 = waistDefault * CFrame.Angles(pitch * 0.4, 0, 0)
		end
	elseif rig == "R6" then
		local raise = weapon.Kind == "Melee" and math.rad(60) or math.pi / 2
		if right then
			right.C0 = rightDefault * CFrame.Angles(0, 0, raise + pitch)
		end
		if left then
			if twoHanded then
				left.C0 = leftDefault * CFrame.Angles(math.rad(-30), 0, -(raise + pitch))
			else
				left.C0 = leftDefault
			end
		end
	end
end

local function hideOwnWeapon()
	local character = localPlayer.Character
	local model = character and character:FindFirstChild("WorldWeapon")
	if not model then
		return
	end
	-- Only hide while the camera is actually in first person.
	local camera = workspace.CurrentCamera
	local head = character:FindFirstChild("Head")
	local firstPerson = head and camera and (camera.CFrame.Position - head.Position).Magnitude < 3
	local modifier = firstPerson and 1 or 0
	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") then
			part.LocalTransparencyModifier = modifier
		end
	end
end

function ThirdPerson.update(dt)
	for _, other in Players:GetPlayers() do
		if other ~= localPlayer and other.Character then
			pose(other.Character, dt)
		end
	end
	hideOwnWeapon()
end

return ThirdPerson
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX0000002B">
			<Properties>
				<string name="Name">Viewmodel</string>
				<ProtectedString name="Source"><![CDATA[-- Viewmodel: first-person arms + weapon, animated entirely in code.
--
-- Every frame the weapon root is placed relative to the camera, then layered
-- offsets are applied: aim-down-sights, sway, bob, recoil, sprint pose, equip,
-- reload, melee swing, throw and pump/bolt cycling. The arms are stretched from
-- fixed shoulder points to the weapon's grip attachments, so they follow every
-- animation automatically.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Spring = require(Shared.Spring)
local Util = require(Shared.Util)

local Viewmodel = {}
Viewmodel.__index = Viewmodel

local player = Players.LocalPlayer

local RIGHT_SHOULDER = Vector3.new(0.95, -1.3, 0.7)
local LEFT_SHOULDER = Vector3.new(-0.95, -1.3, 0.7)
local ARM_WIDTH = 0.42
local SLEEVE_COLOR = Color3.fromRGB(32, 34, 40)
local GLOVE_COLOR = Color3.fromRGB(22, 22, 24)

local rad = math.rad
local ramp = Util.ramp

local function makeArmPart(name, color, size)
	local part = Instance.new("Part")
	part.Name = name
	part.Size = size
	part.Color = color
	part.Material = Enum.Material.SmoothPlastic
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	return part
end

function Viewmodel.new()
	local self = setmetatable({}, Viewmodel)

	self.Folder = Instance.new("Model")
	self.Folder.Name = "Viewmodel"

	self.RightArm = makeArmPart("RightArm", SLEEVE_COLOR, Vector3.new(ARM_WIDTH, ARM_WIDTH, 1))
	self.LeftArm = makeArmPart("LeftArm", SLEEVE_COLOR, Vector3.new(ARM_WIDTH, ARM_WIDTH, 1))
	self.RightHand = makeArmPart("RightHand", GLOVE_COLOR, Vector3.new(0.38, 0.38, 0.45))
	self.LeftHand = makeArmPart("LeftHand", GLOVE_COLOR, Vector3.new(0.38, 0.38, 0.45))
	for _, part in { self.RightArm, self.LeftArm, self.RightHand, self.LeftHand } do
		part.Parent = self.Folder
	end

	self.Sway = Spring.new(Vector3.zero, 90, 11)
	self.Recoil = Spring.new(Vector3.zero, 260, 20)     -- x: pitch, y: yaw, z: push back
	self.Landing = Spring.new(0, 140, 12)
	self.BobTime = 0
	self.BobAmount = 0
	self.Weapon = nil
	self.Visible = true
	self.SwingSide = 1

	self.Folder.Parent = workspace.CurrentCamera
	return self
end

-- Swap to a weapon built by WeaponModels.build(id, true).
function Viewmodel:setWeapon(entry)
	if self.Weapon and self.Weapon.Model then
		self.Weapon.Model.Parent = nil
	end
	self.Weapon = entry
	if entry then
		entry.Model.Parent = self.Folder
		local handle = entry.Model.PrimaryPart
		entry.Muzzle = handle:FindFirstChild("Muzzle")
		entry.RightGrip = handle:FindFirstChild("RightGrip")
		entry.LeftGrip = handle:FindFirstChild("LeftGrip")
		entry.AimPoint = handle:FindFirstChild("AimPoint")
		if not entry.BaseC0 then
			entry.BaseC0 = {}
			for name, weld in entry.Welds do
				entry.BaseC0[name] = weld.C0
			end
		end
		self:setWeaponVisible(true)
	end
end

function Viewmodel:setWeaponVisible(visible)
	if not self.Weapon then
		return
	end
	for _, part in self.Weapon.Model:GetDescendants() do
		if part:IsA("BasePart") and part.Name ~= "Handle" then
			part.LocalTransparencyModifier = visible and 0 or 1
		end
	end
	self.WeaponHidden = not visible
end

function Viewmodel:setVisible(visible)
	self.Visible = visible
	for _, part in self.Folder:GetDescendants() do
		if part:IsA("BasePart") and part.Name ~= "Handle" then
			local hiddenWeaponPart = self.WeaponHidden and self.Weapon and part:IsDescendantOf(self.Weapon.Model)
			part.LocalTransparencyModifier = (visible and not hiddenWeaponPart) and 0 or 1
		end
	end
end

-- Shot feedback: push the weapon back and tilt it up.
function Viewmodel:kick(amount)
	local rng = Random.new()
	self.Recoil.Position += Vector3.new(rad(amount * 22), rad(rng:NextNumber(-1, 1) * amount * 8), amount)
end

function Viewmodel:land(amount)
	self.Landing:Impulse(amount)
end

function Viewmodel:nextSwing()
	self.SwingSide = -self.SwingSide
end

function Viewmodel:destroy()
	self.Folder:Destroy()
end

-- Rotates/translates a named weapon part relative to its rest pose.
local function poseWeld(entry, name, offset)
	local weld = entry.Welds[name]
	if weld then
		weld.C0 = entry.BaseC0[name] * offset
	end
end

local function placeArm(arm, hand, shoulder, target, visible)
	local delta = target - shoulder
	local length = delta.Magnitude
	if length < 0.05 or not visible then
		arm.LocalTransparencyModifier = 1
		hand.LocalTransparencyModifier = 1
		return
	end
	arm.LocalTransparencyModifier = 0
	hand.LocalTransparencyModifier = 0
	local direction = delta / length
	arm.Size = Vector3.new(ARM_WIDTH, ARM_WIDTH, length)
	arm.CFrame = CFrame.lookAt(shoulder + delta / 2, target)
	hand.CFrame = CFrame.lookAt(target + direction * 0.1, target + direction)
end

--[[
	anim fields (all optional):
	  Kind          "Gun" | "Melee" | "Throwable"
	  AdsAlpha      0..1
	  SprintAlpha   0..1
	  Speed         horizontal speed
	  Grounded      bool
	  EquipAlpha    0..1 (1 = fully raised)
	  ReloadAlpha   0..1 while reloading, nil otherwise
	  ShotTime      seconds since last shot
	  CycleAlpha    0..1 pump/bolt cycle after a shot, nil otherwise
	  MeleeAlpha    0..1 during a swing, nil otherwise
	  ThrowAlpha    0..1 during a throw, nil otherwise
	  Sliding       bool
	  Crouching     bool
]]
function Viewmodel:update(dt, cameraCFrame, anim)
	local entry = self.Weapon
	if not entry or not self.Visible then
		return
	end
	local def = entry.Definition
	local kind = anim.Kind or "Gun"

	-- Mouse sway: weapon lags behind camera rotation.
	local mouseDelta = UserInputService:GetMouseDelta()
	local adsAlpha = anim.AdsAlpha or 0
	local swayScale = 1 - adsAlpha * 0.8
	self.Sway.Target = Vector3.new(
		math.clamp(-mouseDelta.Y * 0.004, -0.15, 0.15),
		math.clamp(-mouseDelta.X * 0.004, -0.15, 0.15),
		math.clamp(-mouseDelta.X * 0.006, -0.2, 0.2)
	) * swayScale
	local sway = self.Sway:Update(dt)

	-- Walk bob.
	local speed = anim.Speed or 0
	local moving = anim.Grounded and speed > 1 and not anim.Sliding
	self.BobAmount = Util.approach(self.BobAmount, moving and math.clamp(speed / 16, 0, 1.6) or 0, 8, dt)
	self.BobTime += dt * math.clamp(speed / 16, 0.6, 1.8) * 9
	local bobScale = self.BobAmount * (1 - adsAlpha * 0.9)
	local bob = CFrame.new(
		math.sin(self.BobTime * 0.5) * 0.06 * bobScale,
		-math.abs(math.cos(self.BobTime * 0.5)) * 0.05 * bobScale,
		0
	) * CFrame.Angles(0, 0, math.sin(self.BobTime * 0.5) * rad(1.5) * bobScale)

	-- Idle breathing.
	local t = os.clock()
	local idle = CFrame.new(0, math.sin(t * 1.6) * 0.012 * (1 - adsAlpha), 0)
		* CFrame.Angles(math.sin(t * 1.1) * rad(0.4) * (1 - adsAlpha), 0, 0)

	local recoil = self.Recoil:Update(dt)
	local landing = self.Landing:Update(dt)

	-- Base offset: hip fire blended toward aiming down sights.
	local offset = def.HipOffset
	if kind == "Gun" and entry.AimPoint then
		local aim = entry.AimPoint.Position
		local adsOffset = CFrame.new(-aim.X, -aim.Y, -aim.Z - (def.AdsDistance or 1))
		offset = def.HipOffset:Lerp(adsOffset, Util.smoothstep(adsAlpha))
	end

	-- Crouch / slide: lower and tilt the weapon a little.
	if anim.Sliding then
		offset = CFrame.new(-0.1, 0.05, 0) * CFrame.Angles(0, 0, rad(12)) * offset
	end

	-- Sprint pose: weapon rotates across the body.
	local sprintAlpha = anim.SprintAlpha or 0
	local sprintPose
	if kind == "Gun" then
		sprintPose = CFrame.new(-0.25 * sprintAlpha, -0.2 * sprintAlpha, 0.15 * sprintAlpha)
			* CFrame.Angles(rad(-18) * sprintAlpha, rad(40) * sprintAlpha, rad(18) * sprintAlpha)
	else
		sprintPose = CFrame.new(0, -0.15 * sprintAlpha, 0.1 * sprintAlpha) * CFrame.Angles(rad(-15) * sprintAlpha, 0, 0)
	end

	-- Equip: rise up from below the screen.
	local equip = 1 - Util.smoothstep(anim.EquipAlpha or 1)
	local equipPose = CFrame.new(0.2 * equip, -1.3 * equip, 0.2 * equip) * CFrame.Angles(rad(-55) * equip, rad(15) * equip, rad(10) * equip)

	-- Recoil.
	local recoilPose = CFrame.new(0, 0, recoil.Z * (1 - adsAlpha * 0.5)) * CFrame.Angles(recoil.X, recoil.Y, 0)

	-- Reload.
	local reloadPose = CFrame.new()
	local magOffset = 0
	local leftToMag = 0
	if anim.ReloadAlpha and kind == "Gun" then
		local r = anim.ReloadAlpha
		local tilt = ramp(r, 0, 0.15) * (1 - ramp(r, 0.85, 1))
		local slap = ramp(r, 0.7, 0.75) * (1 - ramp(r, 0.75, 0.85))
		reloadPose = CFrame.new(0, -0.15 * tilt, 0.1 * tilt) * CFrame.Angles(rad(12) * tilt + rad(5) * slap, rad(-10) * tilt, rad(32) * tilt)
		magOffset = ramp(r, 0.18, 0.35) * (1 - ramp(r, 0.5, 0.72))
		leftToMag = ramp(r, 0.12, 0.25) * (1 - ramp(r, 0.72, 0.85))
	end

	-- Melee swing (alternates direction each swing).
	local meleePose = CFrame.new()
	if anim.MeleeAlpha and kind == "Melee" then
		local m = anim.MeleeAlpha
		local side = self.SwingSide
		local windup = ramp(m, 0, 0.18) * (1 - ramp(m, 0.18, 0.38))
		local slash = ramp(m, 0.18, 0.42) * (1 - ramp(m, 0.55, 1))
		meleePose = CFrame.new((0.35 * windup - 1.0 * slash) * side, 0.3 * windup - 0.15 * slash, 0.25 * windup - 0.6 * slash)
			* CFrame.Angles(rad(20 * windup - 25 * slash), rad((25 * windup + 70 * slash) * side), rad(-45 * slash * side))
	end

	-- Throw: wind up behind the head, then snap forward.
	local throwPose = CFrame.new()
	if anim.ThrowAlpha and kind == "Throwable" then
		local a = anim.ThrowAlpha
		local back = ramp(a, 0, 0.35) * (1 - ramp(a, 0.35, 0.5))
		local forward = ramp(a, 0.35, 0.5) * (1 - ramp(a, 0.6, 1))
		throwPose = CFrame.new(0.15 * back, 0.55 * back + 0.2 * forward, 0.7 * back - 0.9 * forward)
			* CFrame.Angles(rad(45 * back - 50 * forward), 0, rad(-10 * back))
	end

	local landingPose = CFrame.new(0, -landing * 0.15, 0) * CFrame.Angles(-landing * rad(4), 0, 0)
	local swayPose = CFrame.Angles(sway.X, sway.Y, sway.Z)

	local root = cameraCFrame
		* swayPose
		* offset
		* bob
		* idle
		* landingPose
		* sprintPose
		* equipPose
		* reloadPose
		* meleePose
		* throwPose
		* recoilPose

	entry.Model.PrimaryPart.CFrame = root

	-- Moving parts.
	if entry.Welds.Mag then
		local drop = def.MagDrop or Vector3.new(0, -1.5, 0.3)
		poseWeld(entry, "Mag", CFrame.new(drop * magOffset))
		entry.Welds.Mag.Part1.LocalTransparencyModifier = (magOffset > 0.7 or self.WeaponHidden) and 1 or 0
	end

	local shotTime = anim.ShotTime or 99
	if entry.Welds.Slide then
		local back = 1 - ramp(shotTime, 0.02, 0.1)
		if shotTime < 0.02 then
			back = ramp(shotTime, 0, 0.02)
		end
		poseWeld(entry, "Slide", CFrame.new(0, 0, 0.2 * back))
	end

	local pumpBack = 0
	if anim.CycleAlpha then
		local c = anim.CycleAlpha
		if entry.Welds.Pump then
			pumpBack = ramp(c, 0.1, 0.4) * (1 - ramp(c, 0.45, 0.75))
			poseWeld(entry, "Pump", CFrame.new(0, 0, 0.4 * pumpBack))
		end
		if entry.Welds.Bolt then
			local up = ramp(c, 0.15, 0.3) * (1 - ramp(c, 0.7, 0.85))
			local back = ramp(c, 0.3, 0.45) * (1 - ramp(c, 0.55, 0.7))
			poseWeld(entry, "Bolt", CFrame.new(0, 0, 0.35 * back) * CFrame.Angles(0, 0, rad(70) * up))
			if entry.Welds.BoltKnob then
				local knob = entry.BaseC0.BoltKnob
				local pivot = entry.BaseC0.Bolt
				-- Swing the knob around the bolt axis.
				local relative = pivot:Inverse() * knob
				entry.Welds.BoltKnob.C0 = pivot * CFrame.new(0, 0, 0.35 * back) * CFrame.Angles(0, 0, rad(70) * up) * relative
			end
		end
	else
		if entry.Welds.Pump then
			poseWeld(entry, "Pump", CFrame.new())
		end
		if entry.Welds.Bolt then
			poseWeld(entry, "Bolt", CFrame.new())
			if entry.Welds.BoltKnob then
				entry.Welds.BoltKnob.C0 = entry.BaseC0.BoltKnob
			end
		end
	end

	-- Arms.
	local rightShoulder = (cameraCFrame * CFrame.new(RIGHT_SHOULDER)).Position
	local leftShoulder = (cameraCFrame * CFrame.new(LEFT_SHOULDER)).Position

	local rightTarget = entry.RightGrip and entry.RightGrip.WorldPosition or root.Position
	local leftVisible = entry.LeftGrip ~= nil and not self.WeaponHidden
	local leftTarget = leftShoulder
	if entry.LeftGrip then
		leftTarget = entry.LeftGrip.WorldPosition
		if pumpBack > 0 then
			leftTarget += root.LookVector * -0.4 * pumpBack
		end
		if leftToMag > 0 and entry.Welds.Mag then
			local magPosition = entry.Welds.Mag.Part1.Position
			leftTarget = leftTarget:Lerp(magPosition, leftToMag)
		end
	end

	-- Hide the right arm too while a throwable has left the hand.
	local rightVisible = not (kind == "Throwable" and self.WeaponHidden)

	placeArm(self.RightArm, self.RightHand, rightShoulder, rightTarget, rightVisible)
	placeArm(self.LeftArm, self.LeftHand, leftShoulder, leftTarget, leftVisible)
end

function Viewmodel:getMuzzlePosition()
	local entry = self.Weapon
	if entry and entry.Muzzle then
		return entry.Muzzle.WorldPosition
	end
	local camera = workspace.CurrentCamera
	return camera.CFrame.Position + camera.CFrame.LookVector * 2
end

-- Applies the player's skin/shirt colours to the viewmodel arms.
function Viewmodel:applyCharacterColors(character)
	local arm = character:FindFirstChild("RightLowerArm") or character:FindFirstChild("Right Arm")
	local hand = character:FindFirstChild("RightHand") or arm
	if arm then
		self.RightArm.Color = arm.Color
		self.LeftArm.Color = arm.Color
	end
	if hand then
		self.RightHand.Color = hand.Color
		self.LeftHand.Color = hand.Color
	end
end

return Viewmodel
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX0000002C">
			<Properties>
				<string name="Name">WeaponController</string>
				<ProtectedString name="Source"><![CDATA[-- WeaponController: input, firing, reloading, aiming, melee and grenades on
-- the client. Shots are raycast here for instant feedback and then sent to
-- the server, which re-checks every hit before applying damage.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Net = require(Shared.Net)
local Util = require(Shared.Util)
local WeaponModels = require(Shared.WeaponModels)

local Viewmodel = require(script.Parent.Viewmodel)
local CameraFX = require(script.Parent.CameraFX)
local Movement = require(script.Parent.Movement)
local Effects = require(script.Parent.Effects)
local HUD = require(script.Parent.HUD)

local WeaponController = {}

local player = Players.LocalPlayer
local rng = Random.new()

local THROW_TIME = 0.6
local THROW_RELEASE = 0.42

local character
local humanoid
local vm
local entries = {}      -- [slot] = { Model, Welds, Definition, Id, Weapon }
local ammo = {}         -- [slot] = { Mag, Reserve }
local charges = 0
local equipped
local lastSlot = "Primary"
local active = false
local connections = {}

local equipStart = 0
local mouseDown = false
local adsHeld = false
local firedThisPress = false
local emptyClicked = false
local adsAlpha = 0
local lastFire = -10
local bloom = 0
local reloading = false
local reloadStart = 0
local meleeStart
local meleeHitDone = false
local lastMelee = -10
local throwStart
local thrown = false
local quickThrowReturn
local lastThrow = -10
local lastPitchSend = 0
local wasGrounded = true
local viewmodelShown = true
local hudKey = ""

local currentSensitivity = 1

-- Scales mouse look while aiming. Wrapped in pcall in case the property is
-- ever locked; only written when the value changes.
local function setSensitivity(value)
	if math.abs(value - currentSensitivity) < 0.005 then
		return
	end
	currentSensitivity = value
	pcall(function()
		UserInputService.MouseDeltaSensitivity = value
	end)
end

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

local function now()
	return os.clock()
end

local function refreshRayParams()
	local list = { workspace.CurrentCamera }
	if character then
		table.insert(list, character)
	end
	local effects = workspace:FindFirstChild("Effects")
	if effects then
		table.insert(list, effects)
	end
	rayParams.FilterDescendantsInstances = list
end

local function currentEntry()
	return equipped and entries[equipped]
end

local function currentWeapon()
	local entry = currentEntry()
	return entry and entry.Weapon
end

local function isFrozen()
	return character ~= nil and character:GetAttribute("Frozen") == true
end

local function canAct()
	return active and not isFrozen() and not HUD.isMenuOpen()
end

local function equipAlpha()
	local weapon = currentWeapon()
	if not weapon then
		return 1
	end
	return math.clamp((now() - equipStart) / weapon.EquipTime, 0, 1)
end

---------------------------------------------------------------------------
-- HUD
---------------------------------------------------------------------------

local function refreshHud(force)
	local weapon = currentWeapon()
	local slotIds = {}
	for slot, entry in entries do
		slotIds[slot] = entry.Id
	end

	local ammoState = equipped and ammo[equipped]
	local key = table.concat({
		tostring(equipped),
		tostring(ammoState and ammoState.Mag),
		tostring(ammoState and ammoState.Reserve),
		tostring(reloading),
		tostring(charges),
		tostring(slotIds.Primary),
		tostring(slotIds.Secondary),
		tostring(slotIds.Melee),
		tostring(slotIds.Utility),
	}, "|")
	if key == hudKey and not force then
		return
	end
	hudKey = key

	HUD.setSlots(slotIds, equipped, charges)
	if weapon and weapon.Kind == "Gun" and ammoState then
		HUD.setAmmo(weapon.DisplayName, ammoState.Mag, ammoState.Reserve, reloading)
	elseif weapon and weapon.Kind == "Throwable" then
		HUD.setAmmo(weapon.DisplayName, charges, 0, false)
	else
		HUD.setAmmo(weapon and weapon.DisplayName or "", nil, nil, false)
	end
end

---------------------------------------------------------------------------
-- Equip / reload
---------------------------------------------------------------------------

local function cancelReload()
	reloading = false
end

local function equip(slot)
	if not active or not entries[slot] or slot == equipped then
		return
	end
	if slot == "Utility" and charges <= 0 then
		return
	end
	if throwStart then
		return
	end

	cancelReload()
	meleeStart = nil
	if equipped and equipped ~= "Utility" then
		lastSlot = equipped
	end
	equipped = slot
	equipStart = now()
	firedThisPress = mouseDown
	vm:setWeapon(entries[slot])
	viewmodelShown = true
	vm:setVisible(true)
	Net.get("Equip"):FireServer(slot)
	Effects.sound("Equip", nil, 0.35, 1.2)
	refreshHud()
end

local function startReload()
	local weapon = currentWeapon()
	local ammoState = equipped and ammo[equipped]
	if not active or not weapon or weapon.Kind ~= "Gun" or not ammoState then
		return
	end
	if reloading or ammoState.Mag >= weapon.MagSize or ammoState.Reserve <= 0 then
		return
	end
	reloading = true
	reloadStart = now()
	Net.get("Reload"):FireServer()
	Effects.sound("Reload", nil, 0.5)
	refreshHud()
end

local function finishReload()
	local weapon = currentWeapon()
	local ammoState = equipped and ammo[equipped]
	reloading = false
	if weapon and ammoState then
		local amount = math.min(weapon.MagSize - ammoState.Mag, ammoState.Reserve)
		ammoState.Mag += amount
		ammoState.Reserve -= amount
	end
	refreshHud()
end

---------------------------------------------------------------------------
-- Guns
---------------------------------------------------------------------------

local function currentSpread(weapon, ctx)
	if not weapon or weapon.Kind ~= "Gun" then
		return 0
	end
	local spread = Util.lerp(weapon.Spread.Hip, weapon.Spread.Ads, adsAlpha)
	local moveFactor = math.clamp((ctx.Speed or 0) / Config.Movement.WalkSpeed, 0, 1.5)
	spread += weapon.Spread.Move * moveFactor * (1 - adsAlpha * 0.5)
	if not ctx.Grounded then
		spread += weapon.Spread.Air
	end
	if ctx.Crouching then
		spread *= 0.8
	end
	return spread + bloom
end

local function fireGun(weapon, ctx)
	local entry = currentEntry()
	local ammoState = ammo[equipped]
	local camera = workspace.CurrentCamera
	local cameraCFrame = camera.CFrame
	local origin = cameraCFrame.Position
	local spread = currentSpread(weapon, ctx)

	refreshRayParams()
	local muzzle = vm:getMuzzlePosition()
	local shots = {}

	for i = 1, weapon.Pellets do
		local direction = Util.spreadDirection(cameraCFrame.LookVector, spread, rng)
		local result = workspace:Raycast(origin, direction * weapon.Range, rayParams)
		local position = result and result.Position or (origin + direction * weapon.Range)
		local part = result and result.Instance
		shots[i] = { Position = position, Part = part }

		local _, hitHumanoid = Util.getCharacterFromPart(part)
		Effects.tracer(muzzle, position)
		if result then
			Effects.impact(position, result.Normal, hitHumanoid ~= nil)
		end
	end

	Net.get("Fire"):FireServer(entry.Id, origin, shots)

	ammoState.Mag -= 1
	lastFire = now()
	firedThisPress = true
	bloom = math.min(bloom + weapon.Recoil.Pitch * 0.35, 4)

	local adsRecoil = 1 - adsAlpha * 0.35
	CameraFX.kick(weapon.Recoil.Pitch * adsRecoil, rng:NextNumber(-1, 1) * weapon.Recoil.Yaw * adsRecoil)
	vm:kick(weapon.Recoil.Kick)
	Effects.muzzleFlash(muzzle, cameraCFrame.LookVector, weapon.Pellets > 1 and 1.4 or 1)
	Effects.sound(weapon.Sound, nil, 0.7)
	refreshHud()
end

local function updateGun(weapon, ctx)
	local ammoState = ammo[equipped]
	if not ammoState then
		return
	end
	local t = now()
	local interval = 60 / weapon.RPM

	if reloading then
		if t - reloadStart >= weapon.ReloadTime then
			finishReload()
		end
		return
	end

	if mouseDown and canAct() and equipAlpha() >= 1 then
		if ctx.Sprinting then
			Movement.cancelSprint()
		end
		local readyForShot = weapon.FireMode == "Auto" or not firedThisPress
		if readyForShot and t - lastFire >= interval then
			if ammoState.Mag > 0 then
				fireGun(weapon, ctx)
			elseif not emptyClicked then
				emptyClicked = true
				Effects.sound("Empty", nil, 0.4, 0.6)
				startReload()
			end
		end
	end

	-- Auto-reload once the last shot has finished cycling.
	if ammoState.Mag <= 0 and t - lastFire >= interval and not reloading then
		startReload()
	end
end

---------------------------------------------------------------------------
-- Melee
---------------------------------------------------------------------------

local function doMeleeHit(weapon)
	local camera = workspace.CurrentCamera
	local origin = camera.CFrame.Position
	local direction = camera.CFrame.LookVector * weapon.Range
	refreshRayParams()

	local result = workspace:Spherecast(origin, 1.2, direction, rayParams) or workspace:Raycast(origin, direction, rayParams)
	local part = result and result.Instance
	local hitCharacter = part and Util.getCharacterFromPart(part)

	Net.get("Melee"):FireServer(hitCharacter and part or nil)

	if hitCharacter then
		Effects.sound("MeleeHit", nil, 0.7)
		Effects.impact(result.Position, result.Normal, true)
		CameraFX.kick(1.5, 0)
	elseif result then
		Effects.impact(result.Position, result.Normal, false)
	end
end

local function updateMelee(weapon)
	local t = now()
	if meleeStart then
		if not meleeHitDone and t - meleeStart >= weapon.HitDelay then
			meleeHitDone = true
			doMeleeHit(weapon)
		end
		if t - meleeStart >= weapon.Cooldown * 0.95 then
			meleeStart = nil
		end
	end

	if mouseDown and canAct() and not meleeStart and equipAlpha() >= 0.6 and t - lastMelee >= weapon.Cooldown then
		lastMelee = t
		meleeStart = t
		meleeHitDone = false
		vm:nextSwing()
		Effects.sound("Swing", nil, 0.6)
		Movement.cancelSprint()
	end
end

---------------------------------------------------------------------------
-- Throwables
---------------------------------------------------------------------------

local function startThrow(quick)
	if not canAct() or throwStart or charges <= 0 then
		return
	end
	local entry = entries.Utility
	if not entry or now() - lastThrow < entry.Weapon.Cooldown then
		return
	end
	if equipped ~= "Utility" then
		if not quick then
			return
		end
		quickThrowReturn = equipped
		equip("Utility")
		if equipped ~= "Utility" then
			quickThrowReturn = nil
			return
		end
	end
	throwStart = now()
	thrown = false
end

local function updateThrow()
	if not throwStart then
		if mouseDown and equipped == "Utility" and equipAlpha() >= 0.8 then
			startThrow(false)
		end
		return
	end

	local alpha = (now() - throwStart) / THROW_TIME
	if alpha >= THROW_RELEASE and not thrown then
		thrown = true
		lastThrow = now()
		local camera = workspace.CurrentCamera
		Net.get("Throw"):FireServer(camera.CFrame.Position, camera.CFrame.LookVector)
		charges = math.max(0, charges - 1)
		vm:setWeaponVisible(false)
		Effects.sound("Throw", nil, 0.6)
		refreshHud()
	end

	if alpha >= 1 then
		throwStart = nil
		if quickThrowReturn or charges <= 0 then
			local target = quickThrowReturn or lastSlot
			quickThrowReturn = nil
			equip(target)
		else
			vm:setWeaponVisible(true)
			equipStart = now()
		end
	end
end

---------------------------------------------------------------------------
-- Loadout / lifecycle
---------------------------------------------------------------------------

local function clearEntries()
	if vm then
		vm:setWeapon(nil)
	end
	for _, entry in entries do
		entry.Model:Destroy()
	end
	table.clear(entries)
	table.clear(ammo)
end

local function buildLoadout()
	if not character or not vm then
		return
	end
	clearEntries()
	charges = 0

	for _, slot in Config.SlotOrder do
		local id = character:GetAttribute(slot)
		local weapon = id and Config.getWeapon(id)
		if weapon then
			local model, welds, definition = WeaponModels.build(id, true)
			entries[slot] = {
				Id = id,
				Weapon = weapon,
				Model = model,
				Welds = welds,
				Definition = definition,
			}
			if weapon.Kind == "Gun" then
				ammo[slot] = { Mag = weapon.MagSize, Reserve = weapon.Reserve }
			elseif weapon.Kind == "Throwable" then
				charges = weapon.Charges
			end
		end
	end

	equipped = nil
	cancelReload()
	meleeStart = nil
	throwStart = nil
	quickThrowReturn = nil
	equip("Primary")
	refreshHud(true)
end

local function deactivate()
	active = false
	mouseDown = false
	adsHeld = false
	adsAlpha = 0
	reloading = false
	throwStart = nil
	meleeStart = nil
	setSensitivity(1)
	for _, connection in connections do
		connection:Disconnect()
	end
	table.clear(connections)
	clearEntries()
	equipped = nil
	if vm then
		vm:destroy()
		vm = nil
	end
	HUD.setCombatVisible(false)
end

local function onCharacterAdded(newCharacter)
	deactivate()
	character = newCharacter
	humanoid = newCharacter:WaitForChild("Humanoid")
	CameraFX.reset()

	Util.waitForAttribute(newCharacter, "LoadoutVersion", 15)
	if character ~= newCharacter or not newCharacter.Parent then
		return
	end

	vm = Viewmodel.new()
	active = true
	HUD.setCombatVisible(true)
	buildLoadout()

	task.delay(1, function()
		if vm and character == newCharacter then
			vm:applyCharacterColors(newCharacter)
		end
	end)

	table.insert(connections, newCharacter:GetAttributeChangedSignal("LoadoutVersion"):Connect(buildLoadout))
	table.insert(connections, humanoid.HealthChanged:Connect(function(health)
		HUD.setHealth(health, humanoid.MaxHealth)
	end))
	table.insert(connections, humanoid.Died:Connect(deactivate))
	HUD.setHealth(humanoid.Health, humanoid.MaxHealth)
end

---------------------------------------------------------------------------
-- Per-frame update
---------------------------------------------------------------------------

function WeaponController.update(dt)
	local camera = workspace.CurrentCamera
	local ctx = Movement.getContext()
	local weapon = active and currentWeapon()

	if not weapon or not vm then
		CameraFX.update(dt, {
			TargetFOV = Config.Camera.DefaultFOV,
			Speed = ctx.Speed,
			Grounded = ctx.Grounded,
		})
		HUD.updateCrosshair(dt, { Spread = 0, Kind = "None", Hidden = true })
		return
	end

	local t = now()
	local menuOpen = HUD.isMenuOpen()

	-- Aim down sights.
	local canAds = weapon.Kind == "Gun" and not reloading and not ctx.Sprinting and not menuOpen and equipAlpha() > 0.5
	adsAlpha = Util.approach(adsAlpha, (adsHeld and canAds) and 1 or 0, weapon.AdsSpeed or 12, dt)
	if adsAlpha < 0.001 then
		adsAlpha = 0
	end

	Movement.weaponSpeedMultiplier = weapon.SpeedMultiplier or 1
	Movement.aiming = adsHeld and canAds
	Movement.blockSprint = mouseDown and weapon.Kind ~= "Throwable" and not menuOpen

	bloom = math.max(0, bloom - dt * 5)

	if weapon.Kind == "Gun" then
		updateGun(weapon, ctx)
	elseif weapon.Kind == "Melee" then
		updateMelee(weapon)
	elseif weapon.Kind == "Throwable" then
		updateThrow()
	end

	-- Re-read: the update above may have switched weapons (after a throw).
	weapon = currentWeapon()
	if not weapon or not vm then
		return
	end

	-- Camera.
	local baseFov = ctx.Sprinting and Config.Camera.SprintFOV or Config.Camera.DefaultFOV
	local targetFov = baseFov
	local sensitivity = 1
	if weapon.Kind == "Gun" then
		targetFov = Util.lerp(baseFov, weapon.AdsFOV, adsAlpha)
		sensitivity = Util.lerp(1, weapon.AdsFOV / Config.Camera.DefaultFOV, adsAlpha)
	end
	setSensitivity(sensitivity)
	CameraFX.update(dt, {
		TargetFOV = targetFov,
		Speed = ctx.Speed,
		Grounded = ctx.Grounded,
		Sprinting = ctx.Sprinting,
		Sliding = ctx.Sliding,
		AdsAlpha = adsAlpha,
	})

	-- Landing bump.
	if ctx.Grounded and not wasGrounded then
		vm:land(4)
	end
	wasGrounded = ctx.Grounded

	-- Sniper scope hides the viewmodel.
	local scoped = weapon.Scope == true and adsAlpha > 0.85
	if viewmodelShown == scoped then
		viewmodelShown = not scoped
		vm:setVisible(viewmodelShown)
	end

	local interval = weapon.RPM and (60 / weapon.RPM) or 0
	local sinceShot = t - lastFire
	local cycleAlpha
	if (weapon.FireMode == "Pump" or weapon.FireMode == "Bolt") and sinceShot < interval then
		cycleAlpha = sinceShot / interval
	end

	vm:update(dt, camera.CFrame, {
		Kind = weapon.Kind,
		AdsAlpha = adsAlpha,
		SprintAlpha = Movement.getSprintAlpha(),
		Speed = ctx.Speed,
		Grounded = ctx.Grounded,
		Sliding = ctx.Sliding,
		Crouching = ctx.Crouching,
		EquipAlpha = equipAlpha(),
		ReloadAlpha = reloading and math.clamp((t - reloadStart) / weapon.ReloadTime, 0, 1) or nil,
		ShotTime = sinceShot,
		CycleAlpha = cycleAlpha,
		MeleeAlpha = meleeStart and math.clamp((t - meleeStart) / (weapon.Cooldown * 0.95), 0, 1) or nil,
		ThrowAlpha = throwStart and math.clamp((t - throwStart) / THROW_TIME, 0, 1) or nil,
	})

	HUD.updateCrosshair(dt, {
		Spread = currentSpread(weapon, ctx),
		AdsAlpha = adsAlpha,
		Kind = weapon.Kind,
		Scoped = scoped,
		Hidden = menuOpen,
	})
	refreshHud()

	-- Tell the server where we're looking so others see our arms aim.
	if t - lastPitchSend > 0.1 then
		lastPitchSend = t
		Net.get("AimPitch"):FireServer(math.asin(math.clamp(camera.CFrame.LookVector.Y, -1, 1)))
	end
end

---------------------------------------------------------------------------
-- Input
---------------------------------------------------------------------------

local SLOT_KEYS = {
	[Config.Keys.Primary] = "Primary",
	[Config.Keys.Secondary] = "Secondary",
	[Config.Keys.Melee] = "Melee",
	[Config.Keys.Utility] = "Utility",
}

local function cycleSlot(step)
	if not equipped then
		return
	end
	local order = Config.SlotOrder
	local index = table.find(order, equipped) or 1
	for _ = 1, #order do
		index = ((index - 1 + step) % #order) + 1
		local slot = order[index]
		if entries[slot] and (slot ~= "Utility" or charges > 0) then
			equip(slot)
			return
		end
	end
end

local function onInputBegan(input, processed)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		if processed then
			return
		end
		mouseDown = true
		firedThisPress = false
		emptyClicked = false
		return
	elseif input.UserInputType == Enum.UserInputType.MouseButton2 then
		if processed then
			return
		end
		adsHeld = true
		return
	end

	if processed then
		return
	end

	if input.KeyCode == Config.Keys.Loadout then
		HUD.toggleMenu()
		return
	end

	if not canAct() then
		return
	end

	local slot = SLOT_KEYS[input.KeyCode]
	if slot then
		equip(slot)
	elseif input.KeyCode == Config.Keys.Reload then
		startReload()
	elseif input.KeyCode == Config.Keys.QuickThrow then
		startThrow(true)
	end
end

local function onInputEnded(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		mouseDown = false
	elseif input.UserInputType == Enum.UserInputType.MouseButton2 then
		adsHeld = false
	end
end

local function onInputChanged(input, processed)
	if processed or input.UserInputType ~= Enum.UserInputType.MouseWheel then
		return
	end
	if canAct() then
		cycleSlot(input.Position.Z > 0 and -1 or 1)
	end
end

---------------------------------------------------------------------------
-- Init
---------------------------------------------------------------------------

function WeaponController.isActive()
	return active
end

function WeaponController.init()
	UserInputService.InputBegan:Connect(onInputBegan)
	UserInputService.InputEnded:Connect(onInputEnded)
	UserInputService.InputChanged:Connect(onInputChanged)

	Net.get("AmmoSync").OnClientEvent:Connect(function(slot, mag, reserve)
		local ammoState = ammo[slot]
		if not ammoState then
			return
		end
		if reloading and slot == equipped then
			return
		end
		ammoState.Mag = mag
		ammoState.Reserve = reserve
		refreshHud()
	end)

	Net.get("ChargesSync").OnClientEvent:Connect(function(serverCharges)
		charges = serverCharges
		refreshHud()
	end)

	Net.get("HitConfirm").OnClientEvent:Connect(function(_damage, headshot, killed)
		HUD.hitmarker(headshot, killed)
		Effects.sound("Hitmarker", nil, killed and 0.9 or 0.5, headshot and 1.4 or 1)
	end)

	Net.get("Damaged").OnClientEvent:Connect(function(amount, sourcePosition)
		HUD.damageFrom(sourcePosition)
		CameraFX.shake(math.clamp(amount * 0.12, 1, 8))
	end)

	player.CharacterAdded:Connect(onCharacterAdded)
	if player.Character then
		task.spawn(onCharacterAdded, player.Character)
	end
end

return WeaponController
]]></ProtectedString>
			</Properties>
		</Item>
	</Item>
</roblox>
